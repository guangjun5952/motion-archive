        "compositionId": "WorkflowReplica",
        "render": "npm run render",
        "adapter": "src/neutral-react.js"
      },
      "install": "npm install",
      "render": "npm run render",
      "renderScript": "node render.mjs",
      "video": {
        "width": 1920,
        "height": 1080,
        "fps": 60,
        "durationInFrames": 450,
        "notes": [
          "原工程以 SVG 二维变换与层级模糊模拟运镜，未使用真实三维摄像机；纯动效保留此实现，不新增物理三维。"
        ]
      },
      "preview": "/workflow/media/editing-workflow-motion-v1.mp4"
    }
  ],
  "invocation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "styled",
            "motion"
          ]
        },
        "sourceInputs": {
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "variant"
      ],
      "additionalProperties": false
    },
    "example": {
      "variant": "styled"
    }
  },
  "styleCompatibility": {
    "automaticBinding": false,
    "referenceStyleIds": [],
    "note": "纯动效入口用于保留运动；绑定新风格仍需显式修改绘制层。"
  },
  "limitations": [
    "原工程以 SVG 二维变换与层级模糊模拟运镜，未使用真实三维摄像机；纯动效保留此实现，不新增物理三维。",
    "sourceInputs 是给派生工程的修改要求，不是 Remotion props；当前不会自动应用源码修改。",
    "只有明确列出的 runtime-prop 支持运行时传参；选择新风格、改变数量或时长不能默认为已支持。"
  ],
  "evidence": {
    "level": "source-and-package-audit",
