{
  "schemaVersion": "asset-usage-1",
  "version": "1.0.0",
  "assetId": "editing-workflow",
  "assetVersion": "1.0.0",
  "name": "八步流程 · 巡游连线",
  "summary": "八个流程节点沿路径串联，镜头连续巡游，高亮逐个交接。",
  "useWhen": [
    "恰好八步的操作流程",
    "从开始到输出的顺序说明"
  ],
  "avoidWhen": [
    "三步或任意节点数量而不重排路径",
    "需要并行分支或循环的流程"
  ],
  "keywords": [
    "流程",
    "八步",
    "步骤",
    "顺序",
    "连线"
  ],
  "capacity": "固定 8 节点；XS、YS、camera 路径与激活时点相互绑定。每项最多 12 字符是保守调用限制，仍需视觉检查。",
  "duration": {
    "seconds": 7.5,
    "policy": "fixed-source-timing",
    "note": "不是已验证的可拉伸时长。新口播不匹配时需调整派生工程并复核两版。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "选择原复刻、纯动效或独立风格入口",
      "mode": "selection",
      "binding": "variants[id]",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion"
        ]
      }
    },
    {
      "key": "labels",
      "label": "八个节点名称",
      "mode": "source-edit",
      "schema": {
        "type": "array",
        "minItems": 8,
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        }
      },
      "binding": "src/scene/index.tsx :: LABELS",
      "note": "保持 8 项；前两项原用英文字体，更换中文时同时改字体绑定。"
    }
  ],
  "variants": [
    {
      "id": "styled",
      "kind": "template",
      "package": "/packages/editing-workflow-styled-1.0.0.zip",
      "packageSha256": "b9e9dd070dc797b02ee0bdb4a97f39cdec7a4dda711696831386608c3e698cce",
      "runtime": {
        "entry": "src/scene/index.tsx",
        "file": "src/scene/index.tsx",
        "export": "Workflow",
        "compositionId": "WorkflowReplica",
        "render": "npm run render"
      },
      "install": "npm install",
      "render": "npm run render",
      "renderScript": "node render.mjs",
      "video": {
        "width": 1920,
        "height": 1080,
        "fps": 60,
        "durationInFrames": 450,
        "notes": [
          "原工程以 SVG 二维变换与层级模糊模拟运镜，未使用真实三维摄像机；纯动效保留此实现，不新增物理三维。"
        ]
      },
      "preview": "/workflow/media/editing-workflow-styled-v1.mp4"
    },
    {
      "id": "motion",
      "kind": "template",
      "package": "/packages/editing-workflow-motion-1.0.0.zip",
