{
  "schemaVersion": "asset-usage-1",
  "version": "1.1.0",
  "assetId": "editing-three-inputs",
  "assetVersion": "1.0.0",
  "name": "三部分文件 · 聚焦展开",
  "summary": "三张文件卡片展开、逐个推进聚焦、景深切换，最后拉回总览。",
  "useWhen": [
    "解释三种输入或三部分材料",
    "三个对象逐一介绍后汇总"
  ],
  "avoidWhen": [
    "超过三项的列表",
    "只强调单个物体而不需要逐项介绍"
  ],
  "keywords": [
    "三部分",
    "输入",
    "聚焦",
    "文件",
    "总览"
  ],
  "capacity": "固定 3 卡；保留开合与焦点时点。标题最多 16 字符为保守调用限制。",
  "duration": {
    "seconds": 14,
    "policy": "fixed-source-timing",
    "note": "不是已验证的可拉伸时长。新口播不匹配时需调整派生工程并复核两版。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "选择原复刻、纯动效或独立风格入口",
      "mode": "selection",
      "binding": "variants[id]",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-portrait",
          "motion-portrait"
        ]
      }
    },
    {
      "key": "titles",
      "label": "三张卡片标题",
      "mode": "source-edit",
      "schema": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        }
      },
      "binding": "src/scene/index.tsx :: const titles",
      "note": "修改 titles 数组；若替换输入类型，同时核对图像与标签。"
    },
    {
      "key": "media",
      "label": "三张卡片图片路径",
      "mode": "source-edit",
      "schema": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "binding": "src/scene/media.ts :: export const media",
      "note": "当前为内嵌图片数组，路径不能直接传入，需在派生工程修改加载方式。"
    }
  ],
