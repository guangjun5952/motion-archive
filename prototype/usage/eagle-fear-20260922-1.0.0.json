  "name": "Fear & Greed · 情绪与交易决策",
  "summary": "31.57秒参考重建。余额与下跌曲线 → 人物和五种情绪 → fear/greed 主体文字 → 上涨与群体欢呼 → 下跌与恐慌 → 计划图形 → 目标和风险 → 情绪曲线与买卖标记 → 心态角色 → 玻璃容器与积累 → 趋势文字 → 保存提示。",
  "useWhen": [
    "对比恐惧贪婪、风险计划与纪律"
  ],
  "avoidWhen": [
    "以此模板输出真实投资建议或真实价格数据"
  ],
  "keywords": [
    "Eagle",
    "2026-09-22",
    "fear",
    "横屏",
    "竖屏",
    "纯动效",
    "对比恐惧贪婪、风险计划与纪律"
  ],
  "capacity": "固定单图表、15 个群体轮廓、双情绪曲线及固定结尾。 文案在镜头源码内修改；新文字需要测量和视觉复核，未开放自动排版参数。",
  "duration": {
    "seconds": 31.566666666666666,
    "frames": 947,
    "fps": 30,
    "policy": "fixed",
    "note": "改变总时长需同时调整各镜头时点、曝光和原音轨，不提供 duration prop。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "画幅和绘制模式",
      "mode": "selection",
      "binding": "src/Root.tsx :: Root / Composition",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-landscape",
          "motion-landscape"
        ]
      },
      "default": "styled",
      "note": "每个变体有独立包；修改 Composition 尺寸不能代替适配。"
    },
    {
      "key": "sceneCopy",
      "label": "逐镜文案修改说明",
      "mode": "source-edit",
      "binding": "src/Fear.tsx :: Fear",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "note": "这是派生源码的修改要求，不是运行时 prop。需逐处替换字面量、检查容量，再由同一时序生成几何版。"
    },
    {
      "key": "motionCurves",
      "label": "弹簧与缓动源码",
      "mode": "source-edit",
      "binding": "src/math.ts :: bounce / ease / track",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "note": "按镜头调整调用值；不是全片统一阻尼参数，也没有自动修改器。"
    }
  ],
