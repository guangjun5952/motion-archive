    "产品价值与多个功能的完整介绍",
    "痛点—产品—价格—行动号召结构"
  ],
  "avoidWhen": [
    "只需几秒的单句强调",
    "未经重编排缩短到任意时长"
  ],
  "keywords": [
    "产品",
    "自由职业",
    "价格",
    "工作区",
    "完整介绍"
  ],
