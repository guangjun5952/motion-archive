          "motion",
          "styled-landscape",
          "motion-landscape"
        ]
      }
    },
    {
      "key": "shotCopy",
      "label": "分镜文案",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2200
      },
      "binding": "src/Film.tsx :: Intro / Mess / Funnel / Product / Orbit / Workspace / Free / Pricing / End",
      "note": "保持既有镜头任务与文字单元。"
    },
    {
      "key": "nestedCards",
      "label": "嵌套财务片段的修改要求",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      },
      "binding": "src/render.mjs :: render",
      "note": "先检查嵌套片段来源与工程；不可仅改外层而保留旧风格片段。"
    }
