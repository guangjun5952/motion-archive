  "summary": "从自由职业痛点进入产品、工作区和价格，最后行动号召的完整产品介绍。",
  "useWhen": [
    "产品价值与多个功能的完整介绍",
    "痛点—产品—价格—行动号召结构"
  ],
  "avoidWhen": [
    "只需几秒的单句强调",
    "未经重编排缩短到任意时长"
  ],
  "keywords": [
    "产品",
    "自由职业",
    "价格",
    "工作区",
    "完整介绍"
  ],
  "capacity": "整条叙事按 shots 固定；长文案、价格与卡片内容需要逐镜编辑。",
  "duration": {
    "seconds": 45.36666666666667,
    "policy": "fixed-source-timing",
    "note": "不是已验证的可拉伸时长。新口播不匹配时需调整派生工程并复核两版。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "选择原复刻、纯动效或独立风格入口",
      "mode": "selection",
      "binding": "variants[id]",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion"
        ]
      }
    },
    {
      "key": "shotCopy",
      "label": "分镜文案",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2200
      },
      "binding": "src/Film.tsx :: Intro / Mess / Funnel / Product / Orbit / Workspace / Free / Pricing / End",
      "note": "保持既有镜头任务与文字单元。"
    },
    {
      "key": "nestedCards",
      "label": "嵌套财务片段的修改要求",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      },
      "binding": "src/render.mjs :: render",
      "note": "先检查嵌套片段来源与工程；不可仅改外层而保留旧风格片段。"
    }
  ],
