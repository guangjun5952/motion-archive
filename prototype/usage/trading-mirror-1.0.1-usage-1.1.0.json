{
  "schemaVersion": "asset-usage-1",
  "version": "1.1.0",
  "assetId": "trading-mirror",
  "assetVersion": "1.0.1",
  "name": "生活与交易 · 镜像叙事",
  "summary": "镜像人物、交易图表、分屏与桌面构成的完整叙事，适合生活习惯与交易行为的类比。",
  "useWhen": [
    "将生活行为与专业表现做类比",
    "习惯、责任、自我改善的连续叙事"
  ],
  "avoidWhen": [
    "精确数据可视化",
    "任意人物动作或写实三维角色"
  ],
  "keywords": [
    "镜像",
    "对比",
    "交易",
    "习惯"
  ],
  "capacity": "按原片多镜头顺序；人物和图表结构固定。替换段落需重新核对每镜停留。",
  "duration": {
    "seconds": 26.133333333333333,
    "policy": "fixed-source-timing",
    "note": "不是已验证的可拉伸时长。新口播不匹配时需调整派生工程并复核两版。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "选择原复刻、纯动效或独立风格入口",
      "mode": "selection",
      "binding": "variants[id]",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-landscape",
          "motion-landscape"
        ]
      }
    },
    {
      "key": "shotCopy",
      "label": "逐镜文案修改要求",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      },
      "binding": "src/Trading.tsx :: Scene",
      "note": "按 Scene 中各镜头文本修改，不能用一条标题覆盖全片。"
    },
    {
      "key": "chartContent",
      "label": "图表与任务内容",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      },
      "binding": "src/Trading.tsx :: Chart / Tasks",
      "note": "数值或行数改变后重新检查几何关系。"
    }
  ],
  "variants": [
    {
      "id": "styled",
      "kind": "template",
