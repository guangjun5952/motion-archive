  "name": "Windows · 彩色文件夹与手势",
  "summary": "4.83秒参考重建。中心文件夹与标签 → 背景文件夹错峰、手指推进 → 点击换粉色 → 恢复青色并展开纸页 → 手势退出、拉远六格。",
  "useWhen": [
    "表达文件整理、分类与文件夹管理"
  ],
  "avoidWhen": [
    "要求可替换为任意数量文件夹而不重排"
  ],
  "keywords": [
    "Eagle",
    "2026-09-22",
    "windows",
    "横屏",
    "竖屏",
    "纯动效",
    "表达文件整理、分类与文件夹管理"
  ],
  "capacity": "一个焦点文件夹、5 个背景文件夹、结尾 6 个网格文件夹。 文案在镜头源码内修改；新文字需要测量和视觉复核，未开放自动排版参数。",
  "duration": {
    "seconds": 4.833333333333333,
    "frames": 145,
    "fps": 30,
    "policy": "fixed",
    "note": "改变总时长需同时调整各镜头时点、曝光和原音轨，不提供 duration prop。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "画幅和绘制模式",
      "mode": "selection",
      "binding": "src/Root.tsx :: Root / Composition",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-landscape",
          "motion-landscape"
        ]
      },
      "default": "styled",
      "note": "每个变体有独立包；修改 Composition 尺寸不能代替适配。"
    },
    {
      "key": "sceneCopy",
      "label": "逐镜文案修改说明",
      "mode": "source-edit",
      "binding": "src/Windows.tsx :: Windows",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "note": "这是派生源码的修改要求，不是运行时 prop。需逐处替换字面量、检查容量，再由同一时序生成几何版。"
    },
    {
      "key": "motionCurves",
      "label": "弹簧与缓动源码",
      "mode": "source-edit",
      "binding": "src/math.ts :: bounce / ease / track",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "note": "按镜头调整调用值；不是全片统一阻尼参数，也没有自动修改器。"
    }
  ],
