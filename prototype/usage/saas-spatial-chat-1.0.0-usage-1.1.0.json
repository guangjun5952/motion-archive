{
  "schemaVersion": "asset-usage-1",
  "version": "1.1.0",
  "assetId": "saas-spatial-chat",
  "assetVersion": "1.0.0",
  "name": "SaaS Chat · 像素生成与空间画廊",
  "summary": "输入卡片、生成按钮、编辑界面与双面画廊组成的 SaaS 产品演示。",
  "useWhen": [
    "AI 输入到生成结果的演示",
    "软件编辑流程与多结果画廊展示"
  ],
  "avoidWhen": [
    "无需软件界面的纯观点强调",
    "期待照片内部具有真实运动"
  ],
  "keywords": [
    "AI",
    "生成",
    "软件",
    "画廊",
    "输入",
    "结果"
  ],
  "capacity": "15 镜头、画廊原有 40 层；数量变化需重新校准布局和遮挡。",
  "duration": {
    "seconds": 27.583333333333332,
    "policy": "fixed-source-timing",
    "note": "不是已验证的可拉伸时长。新口播不匹配时需调整派生工程并复核两版。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "选择原复刻、纯动效或独立风格入口",
      "mode": "selection",
      "binding": "variants[id]",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-portrait",
          "motion-portrait"
        ]
      }
    },
    {
      "key": "shotCopy",
      "label": "输入和界面文案",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1800
      },
      "binding": "src/Film.tsx :: Chat / Generate / List / Words",
      "note": "在每个组件中替换，不能假设统一 compositionProps 已存在。"
    },
    {
      "key": "galleryMedia",
      "label": "画廊图片替换要求",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "binding": "src/Film.tsx :: Gallery",
      "note": "替换 staticFile 所指素材；图片内部仍为静态。"
    }
  ],
  "variants": [
    {
