  "assetVersion": "1.0.0",
  "name": "LIA · 聊天自动化与霓虹图标",
  "summary": "75.57秒参考重建。手机旋转推进、消息与蓝色引导物 → 短语错峰 → 红色否定与黄色交易图标 → 响应速度与真实性短语 → 确认与日历 → 聊天气泡逐项进入 → 异议、信号与交易 → 报告与交易 → 节点与应用图标 → 手机再推进 → 行业图标环 → 紫色盒子与行动词 → 黄色交易图标收尾。",
  "useWhen": [
    "解释聊天响应、自动化服务与多行业覆盖"
  ],
  "avoidWhen": [
    "要求原品牌图标和手机真实三维模型完全一致"
  ],
  "keywords": [
    "Eagle",
    "2026-09-22",
    "lia",
    "横屏",
    "竖屏",
    "纯动效",
    "解释聊天响应、自动化服务与多行业覆盖"
  ],
  "capacity": "固定聊天气泡 6 个、行业图标环 8 个；其他数量需源码重排。 文案在镜头源码内修改；新文字需要测量和视觉复核，未开放自动排版参数。",
  "duration": {
    "seconds": 75.56666666666666,
    "frames": 2267,
    "fps": 30,
    "policy": "fixed",
    "note": "改变总时长需同时调整各镜头时点、曝光和原音轨，不提供 duration prop。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "画幅和绘制模式",
      "mode": "selection",
      "binding": "src/Root.tsx :: Root / Composition",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-landscape",
          "motion-landscape"
        ]
      },
      "default": "styled",
      "note": "每个变体有独立包；修改 Composition 尺寸不能代替适配。"
    },
    {
      "key": "sceneCopy",
      "label": "逐镜文案修改说明",
      "mode": "source-edit",
      "binding": "src/Lia.tsx :: Lia",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "note": "这是派生源码的修改要求，不是运行时 prop。需逐处替换字面量、检查容量，再由同一时序生成几何版。"
    },
    {
      "key": "motionCurves",
      "label": "弹簧与缓动源码",
      "mode": "source-edit",
      "binding": "src/math.ts :: bounce / ease / track",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "note": "按镜头调整调用值；不是全片统一阻尼参数，也没有自动修改器。"
    }
  ],
