        ]
      },
      "default": "styled",
      "note": "每个变体有独立包；修改 Composition 尺寸不能代替适配。"
    },
    {
      "key": "sceneCopy",
      "label": "逐镜文案修改说明",
      "mode": "source-edit",
      "binding": "src/Gates.tsx :: Worldcup",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "note": "这是派生源码的修改要求，不是运行时 prop。需逐处替换字面量、检查容量，再由同一时序生成几何版。"
