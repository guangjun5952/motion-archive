{
  "schemaVersion": "asset-usage-1",
  "version": "1.0.0",
  "assetId": "saas-pixel-garden",
  "assetVersion": "1.0.0",
  "name": "像素花园与荧光绿",
  "summary": "暖橙窗架、鼠尾草绿背景、动态十字像素网格与荧光绿强调色。",
  "useWhen": [
    "需要本风格的配色、文字外观和材质参考"
  ],
  "avoidWhen": [
    "未经适配直接套用到所有模板",
    "只传入风格 ID 就期待源码自动换肤"
  ],
  "keywords": [
    "light",
    "accent",
    "dark",
    "ink",
    "highlight",
    "surface",
    "orange"
  ],
  "capacity": "风格不定义节点数量和时长，遵循目标模板容量。",
  "duration": {
    "seconds": 27.583333333333332,
    "policy": "fixed-source-timing",
    "note": "不是已验证的可拉伸时长。新口播不匹配时需调整派生工程并复核两版。"
  },
