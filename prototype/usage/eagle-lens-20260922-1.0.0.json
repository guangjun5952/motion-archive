  "name": "Persistence · 放大镜焦点追踪",
  "summary": "16.03秒参考重建。放大镜扫视 → You / find → what / you’re → looking / for → when / you → stay → persistent 聚焦与离开。",
  "useWhen": [
    "表现寻找信息、持续探索与从干扰中识别重点"
  ],
  "avoidWhen": [
    "把局部清晰遮罩理解成真实镜头光线折射"
  ],
  "keywords": [
    "Eagle",
    "2026-09-22",
    "lens",
    "横屏",
    "竖屏",
    "纯动效",
    "表现寻找信息、持续探索与从干扰中识别重点"
  ],
  "capacity": "10 个焦点词；背景固定 38 个干扰圆。 文案在镜头源码内修改；新文字需要测量和视觉复核，未开放自动排版参数。",
  "duration": {
    "seconds": 16.033333333333335,
    "frames": 481,
    "fps": 30,
    "policy": "fixed",
    "note": "改变总时长需同时调整各镜头时点、曝光和原音轨，不提供 duration prop。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "画幅和绘制模式",
      "mode": "selection",
      "binding": "src/Root.tsx :: Root / Composition",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-landscape",
          "motion-landscape"
        ]
      },
      "default": "styled",
      "note": "每个变体有独立包；修改 Composition 尺寸不能代替适配。"
    },
    {
      "key": "sceneCopy",
      "label": "逐镜文案修改说明",
      "mode": "source-edit",
      "binding": "src/Lens.tsx :: Lens",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "note": "这是派生源码的修改要求，不是运行时 prop。需逐处替换字面量、检查容量，再由同一时序生成几何版。"
    },
    {
      "key": "motionCurves",
      "label": "弹簧与缓动源码",
      "mode": "source-edit",
      "binding": "src/math.ts :: bounce / ease / track",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "note": "按镜头调整调用值；不是全片统一阻尼参数，也没有自动修改器。"
    }
  ],
