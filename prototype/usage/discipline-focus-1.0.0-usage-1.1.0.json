{
  "schemaVersion": "asset-usage-1",
  "version": "1.1.0",
  "assetId": "discipline-focus",
  "assetVersion": "1.0.0",
  "name": "Discipline · 自律与时间",
  "summary": "自律主题：主体字、日历翻页、任务与人物场景串联，强调长期行动。",
  "useWhen": [
    "自律或持续行动的观点叙事",
    "时间积累与任务完成的说明"
  ],
  "avoidWhen": [
    "当作任意日期的通用日历",
    "以静态替字替代整页翻转"
  ],
  "keywords": [
    "自律",
    "日历",
    "时间",
    "任务",
    "观点"
  ],
  "capacity": "原镜头数量与翻页结构固定；文字时点按 cuts 和场景内部节点编辑。",
  "duration": {
    "seconds": 32.766666666666666,
    "policy": "fixed-source-timing",
    "note": "不是已验证的可拉伸时长。新口播不匹配时需调整派生工程并复核两版。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "选择原复刻、纯动效或独立风格入口",
      "mode": "selection",
      "binding": "variants[id]",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-landscape",
          "motion-landscape"
        ]
      }
    },
    {
      "key": "shotCopy",
      "label": "逐镜主体文案",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      },
      "binding": "src/Film.tsx :: CenterWords / cuts",
      "note": "保留词级出现与强调节奏，默认不新增上方旁白字幕。"
    },
    {
      "key": "taskContent",
      "label": "任务与时间内容",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      },
      "binding": "src/Film.tsx :: Task",
      "note": "修改日历或任务时必须保持整组件运动一致。"
    }
  ],
