  ],
  "invocation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "styled",
            "motion",
            "styled-landscape",
            "motion-landscape"
          ]
        },
        "runtimeProps": {
          "type": "object",
          "properties": {
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "dark": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "incomeTitle": {
              "type": "string",
              "maxLength": 28
            },
            "invoiceTitle": {
              "type": "string",
              "maxLength": 28
            },
            "transactionsTitle": {
              "type": "string",
