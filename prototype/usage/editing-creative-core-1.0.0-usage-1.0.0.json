  "invocation": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "styled",
            "motion"
          ]
        },
        "sourceInputs": {
          "type": "object",
          "properties": {
            "openingText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            },
            "closingText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "variant"
      ],
      "additionalProperties": false
    },
    "example": {
      "variant": "styled"
    }
  },
  "styleCompatibility": {
    "automaticBinding": false,
    "referenceStyleIds": [],
    "note": "纯动效入口用于保留运动；绑定新风格仍需显式修改绘制层。"
  },
  "limitations": [
    "原工程以 SVG 二维变换与层级模糊模拟运镜，未使用真实三维摄像机；纯动效保留此实现，不新增物理三维。",
    "sourceInputs 是给派生工程的修改要求，不是 Remotion props；当前不会自动应用源码修改。",
    "只有明确列出的 runtime-prop 支持运行时传参；选择新风格、改变数量或时长不能默认为已支持。"
  ],
