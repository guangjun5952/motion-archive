{
  "schemaVersion": "asset-usage-1",
  "version": "1.0.0",
  "assetId": "editing-creative-core",
  "assetVersion": "1.0.0",
  "name": "机械劳动与创意",
  "summary": "流程卡片错峰进入，时间线去重与压缩，最后突出人的创意。",
  "useWhen": [
    "说明 AI 处理重复工作、人负责创意",
    "从机械流程转向核心价值"
  ],
  "avoidWhen": [
    "泛用步骤列表",
    "精确展示任意剪辑软件的实际功能"
  ],
  "keywords": [
    "AI",
    "机械劳动",
    "创意",
    "去重",
    "压缩"
  ],
  "capacity": "保留流程—时间线—创意三段结构；字数范围是保守调用约束，不等于排版已测量。",
  "duration": {
    "seconds": 15,
    "policy": "fixed-source-timing",
    "note": "不是已验证的可拉伸时长。新口播不匹配时需调整派生工程并复核两版。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "选择原复刻、纯动效或独立风格入口",
      "mode": "selection",
      "binding": "variants[id]",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion"
        ]
      }
    },
    {
      "key": "openingText",
      "label": "开场主体文字",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      },
      "binding": "src/scene/index.tsx :: 模板化的流程",
      "note": "修改 CN 的 text 属性。"
    },
    {
      "key": "closingText",
      "label": "结尾强调文字",
      "mode": "source-edit",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      },
      "binding": "src/scene/index.tsx :: 你的创意",
      "note": "同时检查文字光晕和落位。"
    }
  ],
  "variants": [
    {
      "id": "styled",
      "kind": "template",
      "package": "/packages/editing-creative-core-styled-1.0.0.zip",
      "packageSha256": "e971176e512ea830e8032e635d06360d8cba799fecd012224c1f0dd328dd0af0",
      "runtime": {
        "entry": "src/scene/index.tsx",
        "file": "src/scene/index.tsx",
        "export": "CreativeCore",
        "compositionId": "CreativeCore",
        "render": "npm run render"
      },
      "install": "npm install",
      "render": "npm run render",
      "renderScript": "node render.mjs",
      "video": {
        "width": 1920,
        "height": 1080,
        "fps": 60,
        "durationInFrames": 900,
        "notes": [
          "原工程以 SVG 二维变换与层级模糊模拟运镜，未使用真实三维摄像机；纯动效保留此实现，不新增物理三维。"
        ]
