  "assetId": "eagle-create-20260922",
  "assetVersion": "1.0.0",
  "name": "Just Create · 创意与行动混剪",
  "summary": "23.70秒参考重建。软件图标和创意短句 → 勇气与划线 → 火花 → 棋子与想法 → 每笔绘画 → 每个音符 → 每个文字 → 色条与工具切换 → 人物与杰作 → JUST CREATE拉远 → 空白背景收尾。",
  "useWhen": [
    "讲解从创意到行动、技能练习和创作工具"
  ],
  "avoidWhen": [
    "需要实拍手部和人物内部动作完全可编辑"
  ],
  "keywords": [
    "Eagle",
    "2026-09-22",
    "create",
    "横屏",
    "竖屏",
    "纯动效",
    "讲解从创意到行动、技能练习和创作工具"
  ],
  "capacity": "固定创意、火花、棋子、3个实拍插片、工具卡与静坐人物。 文案在镜头源码内修改；新文字需要测量和视觉复核，未开放自动排版参数。",
  "duration": {
    "seconds": 23.7,
    "frames": 711,
    "fps": 30,
    "policy": "fixed",
    "note": "改变总时长需同时调整各镜头时点、曝光和原音轨，不提供 duration prop。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "画幅和绘制模式",
      "mode": "selection",
      "binding": "src/Root.tsx :: Root / Composition",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-landscape",
          "motion-landscape"
        ]
      },
      "default": "styled",
      "note": "每个变体有独立包；修改 Composition 尺寸不能代替适配。"
    },
    {
      "key": "sceneCopy",
      "label": "逐镜文案修改说明",
      "mode": "source-edit",
      "binding": "src/Create.tsx :: Create",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "note": "这是派生源码的修改要求，不是运行时 prop。需逐处替换字面量、检查容量，再由同一时序生成几何版。"
    },
    {
      "key": "motionCurves",
      "label": "弹簧与缓动源码",
      "mode": "source-edit",
      "binding": "src/math.ts :: bounce / ease / track",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "note": "按镜头调整调用值；不是全片统一阻尼参数，也没有自动修改器。"
    }
  ],
