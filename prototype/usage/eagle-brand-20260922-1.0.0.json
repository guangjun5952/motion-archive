  "assetVersion": "1.0.0",
  "name": "Brand Handshake · 视觉品牌与信任",
  "summary": "16.00秒参考重建。人物与时钟 → 3秒与商务人物 → 价格卡片与硬币 → 滚动人群 → 刀具强调 → Trust与锁 → 握手和品牌 → 软件图标到品牌落位。",
  "useWhen": [
    "品牌第一印象、设计价值与信任"
  ],
  "avoidWhen": [
    "要求原插画角色可以骨骼动画或自由转向"
  ],
  "keywords": [
    "Eagle",
    "2026-09-22",
    "brand",
    "横屏",
    "竖屏",
    "纯动效",
    "品牌第一印象、设计价值与信任"
  ],
  "capacity": "固定人物、时钟、刀、锁、握手与结尾标志。 文案在镜头源码内修改；新文字需要测量和视觉复核，未开放自动排版参数。",
  "duration": {
    "seconds": 16,
    "frames": 480,
    "fps": 30,
    "policy": "fixed",
    "note": "改变总时长需同时调整各镜头时点、曝光和原音轨，不提供 duration prop。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "画幅和绘制模式",
      "mode": "selection",
      "binding": "src/Root.tsx :: Root / Composition",
      "schema": {
        "type": "string",
        "enum": [
          "styled",
          "motion",
          "styled-landscape",
          "motion-landscape"
        ]
      },
      "default": "styled",
      "note": "每个变体有独立包；修改 Composition 尺寸不能代替适配。"
    },
    {
      "key": "sceneCopy",
      "label": "逐镜文案修改说明",
      "mode": "source-edit",
      "binding": "src/Brand.tsx :: Brand",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "note": "这是派生源码的修改要求，不是运行时 prop。需逐处替换字面量、检查容量，再由同一时序生成几何版。"
    },
    {
      "key": "motionCurves",
      "label": "弹簧与缓动源码",
      "mode": "source-edit",
      "binding": "src/math.ts :: bounce / ease / track",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "note": "按镜头调整调用值；不是全片统一阻尼参数，也没有自动修改器。"
    }
  ],
