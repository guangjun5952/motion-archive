  "name": "Myna · AI 提问与括号排字",
  "summary": "5.43秒参考重建。输入问题并收缩字号 → 括号收束 → AI Agent逐字落位 → 白底花括号与三个术语。",
  "useWhen": [
    "产品开场提问、AI Agent 和开发流程引入"
  ],
  "avoidWhen": [
    "无限长文字、任意插入更多问题而不重编时序"
  ],
  "keywords": [
    "Eagle",
    "2026-09-22",
    "myna",
    "横屏",
    "竖屏",
    "纯动效",
    "产品开场提问、AI Agent 和开发流程引入"
  ],
  "capacity": "一个27字符问题、一个9字符短词和3个结尾术语；长度是原稿数量，不代表通用安全上限。 文案在镜头源码内修改；新文字需要测量和视觉复核，未开放自动排版参数。",
  "duration": {
    "seconds": 5.433333333333334,
    "frames": 163,
    "fps": 30,
    "policy": "fixed",
    "note": "改变总时长需同时调整各镜头时点、曝光和原音轨，不提供 duration prop。"
  },
  "parameters": [
    {
      "key": "variant",
      "label": "画幅和绘制模式",
      "mode": "selection",
      "binding": "src/Root.tsx :: Root / Composition",
      "schema": {
        "type": "string",
        "enum": [
          "styled-portrait",
          "motion-portrait",
          "styled",
          "motion"
        ]
      },
      "default": "styled",
      "note": "每个变体有独立包；修改 Composition 尺寸不能代替适配。"
    },
    {
      "key": "sceneCopy",
      "label": "逐镜文案修改说明",
      "mode": "source-edit",
      "binding": "src/Myna.tsx :: Myna",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "note": "这是派生源码的修改要求，不是运行时 prop。需逐处替换字面量、检查容量，再由同一时序生成几何版。"
    },
    {
      "key": "motionCurves",
      "label": "弹簧与缓动源码",
      "mode": "source-edit",
      "binding": "src/math.ts :: bounce / ease / track",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "note": "按镜头调整调用值；不是全片统一阻尼参数，也没有自动修改器。"
    }
  ],
